# Copy this file to .env (in this backend/ folder) and fill in your key.
# Get your key from the Manus web app: Settings -> Integrations ->
# "Build with Manus API". Docs: https://open.manus.im/docs/v2/authentication
MANUS_API_KEY=

# Manus API base URL. Only override this if Manus moves/versions the API.
MANUS_API_BASE=https://api.manus.ai/v2

# Agent tier for every call in this app. "lite" is Manus's stable alias for
# its lightweight/fast agent tier — currently Manus Lite 1.6. Other stable
# values are "standard" and "max". Versioned aliases (e.g. "1.6-lite") are
# also accepted but the version segment is ignored, so prefer "lite" here.
MANUS_AGENT_PROFILE=lite

# Manus doesn't have a Gemini-style requests-per-minute free tier — instead
# it caps *concurrent* tasks per account (commonly 20). This app pools calls
# through this many concurrent Manus tasks at once; keep it comfortably under
# your account's concurrent-task limit.
MANUS_MAX_CONCURRENT_TASKS=5

PORT=3000

# The frontend is a separate app/origin (see ../frontend). No cookies are
# used for sessions (just the x-study-session header), so "*" is fine for
# local dev. For a real deployment, set this to your frontend's actual origin,
# e.g. FRONTEND_ORIGIN=https://study-helper.example.com
FRONTEND_ORIGIN=*
