# Copy this file to .env (in this backend/ folder) and fill in your key.
# Get a free key at https://ai.google.dev/gemini-api/docs/pricing
GEMINI_API_KEY=AQ.Ab8RN6JyUAymQy55w7w7vOc2O4HNndafn1_TBeQgOYOLJcnKZA

# Model routing (override if you want different Gemini models)
# NOTE: Google retires Gemini model ids on a rolling schedule — gemini-1.5-*
# and gemini-2.5-* are both already retired as of this writing (Aug 2026).
# Currently configured: gemini-3.6-flash / gemini-3.5-flash-lite (GA as of
# July 2026, introductory pricing through Dec 31 2026 per Google's docs).
# If calls start 404ing, check https://ai.google.dev/gemini-api/docs/models
# for current ids and update the values below — no code changes needed.
GEMINI_MODEL_KEYTERMS=gemini-3.5-flash-lite
GEMINI_MODEL_KEYTERMS_FALLBACK=gemini-3.6-flash
GEMINI_MODEL_DEFINE=gemini-3.6-flash
GEMINI_MODEL_SUMMARY=gemini-3.6-flash
GEMINI_MODEL_SUMMARY_FALLBACK=gemini-3.5-flash-lite
GEMINI_MODEL_QUIZ=gemini-3.6-flash
GEMINI_MODEL_QUIZ_FALLBACK=gemini-3.5-flash-lite
GEMINI_MODEL_OCR=gemini-3.6-flash

PORT=3000

# The frontend is now a separate app/origin (see ../frontend). No cookies are
# used for sessions (just the x-study-session header), so "*" is fine for
# local dev. For a real deployment, set this to your frontend's actual origin,
# e.g. FRONTEND_ORIGIN=https://study-helper.example.com
FRONTEND_ORIGIN=*
