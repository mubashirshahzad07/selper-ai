# Copy this file to .env (in this backend/ folder) and fill in both keys.
# This app uses two AI providers for different features — see the comment
# block at the top of src/services/ai.js for the full rationale:
#   Gemini -> OCR (image/scanned-PDF transcription) and Definitions
#             (word lookup, translate, summarize, key terms, free-text grading)
#   Manus  -> Quiz Generation (quiz + follow-up questions)

# --- Gemini (OCR + Definitions) ---------------------------------------------
# Get your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Manus (Quiz Generation) -------------------------------------------------
# Get your key from the Manus web app: Settings -> Integrations ->
# "Build with Manus API". Docs: https://open.manus.im/docs/v2/authentication
MANUS_API_KEY=
MANUS_API_BASE=https://api.manus.ai/v2

# Agent tier for quiz-generation calls. "lite" is Manus's stable alias for
# its lightweight/fast agent tier — currently Manus Lite 1.6. Other stable
# values are "standard" and "max".
MANUS_AGENT_PROFILE=manus-1.6-lite

# Manus caps *concurrent* tasks per account (commonly 20), not
# requests-per-minute, and rate-limits task.create to 10/min. Quiz generation
# pools through this many concurrent Manus tasks at once; keep it comfortably
# under your account's limit.
MANUS_MAX_CONCURRENT_TASKS=2

PORT=3000

# The frontend is a separate app/origin (see ../frontend). No cookies are
# used for sessions (just the x-study-session header), so "*" is fine for
# local dev. For a real deployment, set this to your frontend's actual origin,
# e.g. FRONTEND_ORIGIN=https://study-helper.example.com
FRONTEND_ORIGIN=*
